---
import { site } from '../data/site';

const topics = [
  { title: 'Familie', text: 'Muster, Loyalitäten, Generationen.' },
  { title: 'Partnerschaft', text: 'Nähe, Abstand, festgesetzte Rollen.' },
  { title: 'Beruf', text: 'Teams, Aufgaben, Entscheidungen.' },
] as const;
---

<section class="section section--surface" id="anliegen" aria-labelledby="anliegen-heading">
  <div class="wrap split">
    <div class="split__media">
      <img
        src={site.images.turtle}
        width="1024"
        height="559"
        alt="Glasschildkröte auf einem Holzbrett, umgeben von Holzfiguren und einem kleinen Haus"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="split__copy">
      <p class="eyebrow">Anliegen</p>
      <h2 id="anliegen-heading">Womit Menschen kommen</h2>
      <ul class="topic-list">
        {
          topics.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
