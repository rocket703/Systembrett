---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__copy">© {year} <span class="ph">[Markenname]</span></p>
    <nav aria-label="Rechtliches">
      <a href={withBase('/impressum')}>Impressum</a>
      <a href={withBase('/datenschutz')}>Datenschutz</a>
    </nav>
    <p class="site-footer__credit">
      Gestaltung:
      <a href={site.designer.url} rel="noopener noreferrer" target="_blank">{site.designer.name}</a>
    </p>
  </div>
</footer>
