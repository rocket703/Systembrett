---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__media" aria-hidden="true"></div>

  <div class="wrap">
    <div class="hero__content">
      <h1 id="hero-heading" class="hero__title">
        <span class="hero__title-head">
          <span class="sr-only">Systembrettaufstellung</span>
          <span aria-hidden="true">Systembrett-<br />aufstellung</span>
          <span class="hero__title-place">in <em>Magdeburg</em></span>
        </span>
        <span class="sr-only"> – </span>
        <span class="hero__title-sub">Individuelle Begleitung und systemische Beratung</span>
      </h1>
      <div class="hero__cta">
        <div class="hero__actions">
          <a class="btn btn--primary" href={withBase('/kontakt')}>Erstgespräch vereinbaren</a>
          <a class="btn btn--ghost hero__tel" href={site.phoneHref} aria-label={`Anrufen: ${site.phone}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
            </svg>
          </a>
          <a class="btn btn--ghost" href={withBase('/methode')}>So läuft ein Termin ab</a>
        </div>
        <blockquote class="quote hero__quote">
          <p>„Verstehen beginnt oft dort, wo wir bereit sind, genauer hinzusehen.“</p>
        </blockquote>
      </div>
    </div>
  </div>
</section>
