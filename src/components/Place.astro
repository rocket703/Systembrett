---
import { site } from '../data/site';
---

<section class="section place" id="magdeburg" aria-labelledby="magdeburg-heading">
  <div class="wrap place__card">
    <img
      class="place__img"
      src={site.images.turtle}
      width="1024"
      height="559"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="place__panel">
      <p class="place__eyebrow">Beratungsort</p>
      <h2 id="magdeburg-heading">Hier findet die Beratung statt</h2>
      <p class="place__location">[Ort folgt]</p>
      <p class="place__detail">Der genaue Ort steht noch nicht fest und wird hier ergänzt.</p>
      <p class="place__note">
        Psychologische Beratung am Systembrett. Kein Ersatz für Psychotherapie oder ärztliche Behandlung.
      </p>
    </div>
  </div>
</section>
