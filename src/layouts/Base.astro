---
interface Props {
  title: string;
  description: string;
}
import '../styles/global.css';
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#dcdee3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,600;1,700&family=Fraunces:opsz,wght@9..144,400;9..144,560&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="nav" data-nav>
      <div class="nav-bar">
        <a class="brand" href="/">Vanessa</a>
        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="hauptnav"
        >
          <span class="nav-toggle-lines"></span>
          <span class="nav-toggle-label">Menü</span>
        </button>
        <nav class="nav-links" id="hauptnav" data-nav-links aria-label="Hauptnavigation">
          <a href="/#anliegen">Anliegen</a>
          <a href="/#ablauf">Ablauf</a>
          <a href="/#kontakt">Kontakt</a>
        </nav>
      </div>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Rechtliches">
          <a href="/impressum" aria-current={path === '/impressum' ? 'page' : undefined}>Impressum</a>
          <a href="/datenschutz" aria-current={path === '/datenschutz' ? 'page' : undefined}>Datenschutz</a>
        </nav>
        <p>Systembrett-Aufstellung in Magdeburg · Platzhalter, vor dem Veröffentlichen ergänzen.</p>
      </div>
    </footer>
    <script>
      const nav = document.querySelector('[data-nav]');
      const toggle = document.querySelector('[data-nav-toggle]');
      const links = document.querySelector('[data-nav-links]');
      const desktop = window.matchMedia('(min-width: 800px)');

      const setOpen = (open: boolean) => {
        if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
        document.body.classList.toggle('nav-open', open);
      };

      const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        setOpen(open);
      });

      links?.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      });

      desktop.addEventListener('change', () => {
        if (desktop.matches) setOpen(false);
      });
    </script>
  </body>
</html>
