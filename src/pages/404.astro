---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Seite nicht gefunden | Vanessa Wöhner"
  description="Die gesuchte Seite gibt es leider nicht. Hier finden Sie zurück zur Systembrett-Aufstellung in Magdeburg."
  noindex
>
  <section class="section not-found" aria-labelledby="not-found-heading">
    <div class="wrap not-found__inner">
      <div class="not-found__copy">
        <p class="not-found__eyebrow">Seite nicht gefunden</p>
        <h1 id="not-found-heading">Hier ist gerade<br /> nichts zu finden.</h1>
        <p class="lead">
          Die Adresse stimmt vielleicht nicht mehr. Über diese Wege finden Sie zurück.
        </p>
        <nav class="not-found__actions" aria-label="Weiterführende Links">
          <a class="btn btn--primary" href={withBase('/')}>Zur Startseite</a>
          <a class="btn btn--ghost" href={withBase('/kontakt')}>Kontakt aufnehmen</a>
        </nav>
      </div>
      <p class="not-found__code" aria-hidden="true">
        <span>4</span>
        <img
          src={withBase('/images/turtle.svg')}
          alt=""
          width="1456"
          height="1420"
          decoding="async"
        />
        <span>4</span>
      </p>
    </div>
  </section>
</BaseLayout>
