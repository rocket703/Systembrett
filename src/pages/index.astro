---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MethodTeaser from '../components/MethodTeaser.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Place from '../components/Place.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faq';
import { seoPages } from '../data/seo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => {
    const answerText =
      'duration' in item
        ? `${item.a}${item.duration}${item.after}`
        : `${item.a}${'points' in item ? ` ${item.points.join(' ')}` : ''}${'after' in item ? ` ${item.after}` : ''}`;

    return {
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: answerText },
    };
  }),
};
---

<BaseLayout
  title={seoPages.home.title}
  description={seoPages.home.description}
  ogTitle={seoPages.home.ogTitle}
  toTop
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <Hero />
  <About />
  <QuoteBand />
  <MethodTeaser />
  <Place />
  <Faq />
</BaseLayout>